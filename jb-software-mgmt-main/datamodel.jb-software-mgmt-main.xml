		<class id="SoftwareInstallation" _delta="define">
			<parent>FunctionalCI</parent>
			<properties>
				<category>bizmodel,searchable</category>
				<abstract>false</abstract>
				<key_type>autoincrement</key_type>
				<db_table>software_mgmt_installation</db_table>
				<db_key_field>id</db_key_field>
				<db_final_class_field/>
				<naming>
					<attributes>
						<!-- Obscure iTop issue: "failed to create alias" if you use functionalci_id_friendlyname -->
						<attribute id="softwarebuild_friendlyname"/>
						<attribute id="functionalci_name"/>
						<attribute id="organization_name"/>
					</attributes>
				</naming>
				<order>
					<columns>
						<column id="softwarebuild_id" ascending="true"/>
						<column id="functionalci_id" ascending="true"/>
					</columns>
				</order>
				<reconciliation>
					<attributes>
						<attribute id="softwarebuild_id"/>
						<attribute id="functionalci_id"/>
					</attributes>
				</reconciliation>
				<style>
					<icon>images/SoftwareInstance.png</icon>
				</style>
				<uniqueness_rules>
					<rule id="UniqueSoftwareInstallationPerOrganization">
						<attributes>
							<attribute id="org_id"/>
							<attribute id="softwarebuild_id"/>
							<attribute id="functionalci_id"/>
						</attributes>
						<is_blocking>true</is_blocking>
					</rule>
				</uniqueness_rules>
				<obsolescence>
					<condition>status='obsolete'</condition>
				</obsolescence>
			</properties>
			<fields>
				<!-- 2020-02-18: 
					It might be interesting to have a dependency for FunctionalCI and SoftwareVersion to share the same org_id.
					However, some organizations may share a license.
				-->
				<field id="functionalci_id" xsi:type="AttributeExternalKey">
					<sql>functionalci_id</sql>
					<is_null_allowed>false</is_null_allowed>
					<on_target_delete>DEL_AUTO</on_target_delete>
					<target_class>FunctionalCI</target_class>
					<filter><![CDATA[
						SELECT FunctionalCI 
						WHERE finalclass IN ('Hypervisor', 'NetworkDevice', 'Printer', 'PC', 'Server', 'VirtualMachine')
					]]>					</filter>
				</field>
				<field id="install_date" xsi:type="AttributeDateTime">
					<sql>install_date</sql>
					<default_value/>
					<is_null_allowed>false</is_null_allowed>
				</field>
				<field id="functionalci_name" xsi:type="AttributeExternalField">
					<extkey_attcode>functionalci_id</extkey_attcode>
					<target_attcode>name</target_attcode>
				</field>
				<field id="softwarebuild_id" xsi:type="AttributeExternalKey">
					<sql>softwarebuild_id</sql>
					<is_null_allowed>false</is_null_allowed>
					<on_target_delete>DEL_AUTO</on_target_delete>
					<target_class>SoftwareBuild</target_class>
				</field>
				<field id="softwarebuild_friendlyname" xsi:type="AttributeExternalField">
					<extkey_attcode>softwarebuild_id</extkey_attcode>
					<target_attcode>friendlyname</target_attcode>
				</field>
				<field id="softwarebuild_softwarereleasetype_id" xsi:type="AttributeExternalField">
					<extkey_attcode>softwarebuild_id</extkey_attcode>
					<target_attcode>softwarereleasetype_id</target_attcode>
				</field>
				<field id="softwarebuild_status" xsi:type="AttributeExternalField">
					<extkey_attcode>softwarebuild_id</extkey_attcode>
					<target_attcode>status</target_attcode>
				</field>
				<field id="softwarelicense_id" xsi:type="AttributeExternalKey">
					<sql>softwarelicense_id</sql>
					<!-- Not all software has a license. -->
					<is_null_allowed>true</is_null_allowed>
					<on_target_delete>DEL_AUTO</on_target_delete>
					<target_class>SoftwareLicense</target_class>
					<filter><![CDATA[
						SELECT SoftwareLicense AS l 
						JOIN lnkSoftwareLicenseToSoftwareVersion AS lnk ON lnk.softwarelicense_id = l.id 
						JOIN SoftwareVersion AS sv ON lnk.softwareversion_id = sv.id 
						JOIN SoftwareBuild AS sb ON sb.softwareversion_id = sv.id
						WHERE 
							sb.id = :this->softwarebuild_id
					]]>					</filter>
					<dependencies>
						<attribute id="softwarebuild_id"/>
					</dependencies>
				</field>
				<field id="softwarelicense_id_friendlyname" xsi:type="AttributeExternalField">
					<extkey_attcode>softwarelicense_id</extkey_attcode>
					<target_attcode>friendlyname</target_attcode>
				</field>
				<field id="status" xsi:type="AttributeEnum">
					<sql>status</sql>
					<values>
						<value id="implementation">
							<code>implementation</code>
						</value>
						<value id="obsolete">
							<code>obsolete</code>
						</value>
						<value id="production">
							<code>production</code>
						</value>
					</values>
					<is_null_allowed>true</is_null_allowed>
				</field>
			</fields>
			<methods>
				<!-- Trick to avoid a warning in the frontend about 'name' being empty, since it's a required field (due to parent class) -->
				<method id="PrefillCreationForm" _delta="define">
					<static>false</static>
					<access>public</access>
					<type>Overload-DBObject</type>
					<arguments>
						<argument id="1">
							<type>reference</type>
							<mandatory>true</mandatory>
						</argument>
					</arguments>
					<code><![CDATA[
					
						public function PrefillCreationForm(&$aContextParam) {
						
							parent::PrefillCreationForm($aContextParam);
							
							$this->Set('name', 'Name'); // Doesn't really matter
						}
						
					]]>					</code>
				</method>
				<method id="OnInsert">
					<static>false</static>
					<access>protected</access>
					<type>Overload-DBObject</type>
					<code><![CDATA[
				  
						public function OnInsert() {
			
							parent::OnInsert();
							
							// Remember how the "name" didn't matter (specific dummy value in PrefillCreationForm and hidden elsewhere?)
							$this->Set('name', $this->Get('softwarebuild_friendlyname').' | '.$this->Get('functionalci_name'));
						
						}
						
					]]>					</code>
				</method>
				<method id="OnUpdate">
					<static>false</static>
					<access>protected</access>
					<type>Overload-DBObject</type>
					<code><![CDATA[
				  
						public function OnUpdate() {
						
							parent::OnUpdate();
							
							$aChanges = $this->ListChanges();
							if(array_key_exists('functionalci_id', $aChanges) || array_key_exists('softwarebuild_id', $aChanges)) {
								$this->Set('name', $this->Get('softwarebuild_friendlyname').' | '.$this->Get('functionalci_name'));
							}
							
						}
